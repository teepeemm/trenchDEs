\newenvironment{exerciselist}[1][]{%
 \begin{enumext}[
  label=\arabic*,
  start={1+\value{exercise}},
  wrap-label*={##1.},
  topsep=10pt,
  partopsep=0pt,
  itemsep=0pt,
  labelwidth=16pt,
  labelsep=12pt,
%  columns=2,
%  item-join=2,
  after={\setcounter{exercise}{\value{enumXi}}},
  #1
 ]%
}{%
 \end{enumext}%
}
\newenvironment{exerciselistTwoColumn}[1][]{%
 \begin{enumext*}[
  label=\arabic*,
  start={1+\value{exercise}},
  wrap-label*={##1.},
  topsep=10pt,
  partopsep=0pt,
  itemsep=0pt,
  labelwidth=16pt,
  labelsep=12pt,
  columns=2,
  after={\setcounter{exercise}{\value{enumXvii}}},
  #1
 ]%
}{%
 \end{enumext*}%
}

\newenvironment{alist}[1][]{%
 \begin{enumext}[
  label=\alph*,
  wrap-label*={(##1)},
  topsep=0pt,
  partopsep=0pt,
  itemsep=0pt,
  labelwidth=14pt,
  labelsep=8pt,
  #1
 ]%
}{%
 \end{enumext}%
}
\newenvironment{alist*}[1][]{%
 \begin{enumext*}[
  label=\alph*,
  wrap-label*={(##1)},
  topsep=0pt,
  partopsep=0pt,
  itemsep=0pt,
  labelwidth=14pt,
  labelsep=8pt,
  #1
 ]%
}{%
 \end{enumext*}%
}

\newenvironment{alistSolution}[1][]{%
 \pushQED {\qed }% allows \qedhere
 \begin{enumext}[
  label=\alph*,
  wrap-label*={{\color{blue}\textsc{Solution}(##1)}},
  topsep=0pt,
  partopsep=0pt,
  itemsep=0pt,
  list-indent=0pt,
  labelwidth=6em,
  labelsep=8pt,
  #1
 ]%
}{%
 \popQED
 \end{enumext}%
}

